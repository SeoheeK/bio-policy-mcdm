## etcd 공통 환경변수 예시
## 각 노드에서 아래 값을 “노드별로” 수정하세요.

# 노드명(예: etcd-1)
ETCD_NAME=etcd-1

# 데이터 저장 경로
ETCD_DATA_DIR=/var/lib/etcd

# 클러스터 내부 통신(Peer)
ETCD_LISTEN_PEER_URLS=http://10.10.21.70:2380
ETCD_INITIAL_ADVERTISE_PEER_URLS=http://10.10.21.70:2380

# 클라이언트 접속(Client)
ETCD_LISTEN_CLIENT_URLS=http://10.10.21.70:2379,http://127.0.0.1:2379
ETCD_ADVERTISE_CLIENT_URLS=http://10.10.21.70:2379

# 클러스터 초기 멤버(모든 노드 동일)
ETCD_INITIAL_CLUSTER=etcd-1=http://10.10.21.70:2380,etcd-2=http://10.10.21.71:2380,etcd-3=http://10.10.21.72:2380
ETCD_INITIAL_CLUSTER_STATE=new
ETCD_INITIAL_CLUSTER_TOKEN=bems-etcd-cluster

