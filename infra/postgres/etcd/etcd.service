[Unit]
Description=etcd key-value store
Documentation=https://etcd.io/docs/
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=etcd
Group=etcd

EnvironmentFile=-/etc/etcd/etcd.env

ExecStart=/usr/bin/etcd
Restart=always
RestartSec=5

LimitNOFILE=65536

[Install]
WantedBy=multi-user.target

