## Patroni 서비스 실행 환경변수(예시)
## 실제 운영에서는 /etc/patroni/patroni.env 로 배치하고 권한을 제한하세요.

# Patroni REST API basic auth
PATRONI_REST_API_USER=patroni
PATRONI_REST_API_PASSWORD=CHANGE_ME

# PostgreSQL 계정 비밀번호
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
POSTGRES_REPL_PASSWORD=CHANGE_ME
POSTGRES_APP_PASSWORD=CHANGE_ME

