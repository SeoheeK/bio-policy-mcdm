## 통합 백업 실행 환경변수 예시 (실제 값은 secrets로 주입)

# 공통
BACKUP_ROOT=/backup

# SSH(중앙 오케스트레이터에서 원격 실행하는 경우)
SSH_USER=backup
SSH_OPTS="-o StrictHostKeyChecking=no"

# PostgreSQL (HAProxy Primary endpoint 권장)
PGHOST=10.10.21.15
PGPORT=5432
PGUSER=replicator
PGPASSWORD=CHANGE_ME
PG_RETENTION_DAYS=30

# MongoDB
MONGO_HOST=10.10.21.20
MONGO_PORT=27017
MONGO_ADMIN_USER=admin
MONGO_ADMIN_PASSWORD=CHANGE_ME
MONGO_RETENTION_DAYS=30

# Neo4j (Enterprise online backup)
NEO4J_BACKUP_FROM=10.10.21.30:6362
NEO4J_DATABASE=neo4j
NEO4J_RETENTION_DAYS=30

# OpenSearch Snapshot(→ MinIO repository)
OPENSEARCH_HOST=10.10.21.50
OPENSEARCH_ADMIN_USER=admin
OPENSEARCH_ADMIN_PASSWORD=CHANGE_ME
OPENSEARCH_SNAPSHOT_REPO=bems_minio_repo
OPENSEARCH_RETENTION_DAYS=30

# Redis Cluster
REDIS_PASSWORD=CHANGE_ME
REDIS_NODES="10.10.21.40:6379 10.10.21.41:6379 10.10.21.42:6379 10.10.21.43:6379 10.10.21.44:6379 10.10.21.45:6379"
REDIS_RETENTION_DAYS=7

# Qdrant
QDRANT_HOST=10.10.21.60
QDRANT_PORT=6333
QDRANT_COLLECTION=bems_policy_documents
QDRANT_RETENTION_DAYS=90

# MinIO 외부 mirror(선택)
MINIO_ENDPOINT=http://10.10.31.10:9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_RETENTION_DAYS=90

