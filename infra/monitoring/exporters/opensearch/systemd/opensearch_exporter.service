[Unit]
Description=Prometheus OpenSearch Exporter (elasticsearch_exporter)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=osexp
Group=osexp
EnvironmentFile=-/etc/opensearch_exporter/opensearch_exporter.env

# --ssl-skip-verify 는 사내 CA 적용 전까지 임시(운영에서는 CA 지정 권장)
ExecStart=/usr/local/bin/elasticsearch_exporter \
  --web.listen-address=:9114 \
  --es.uri=${OPENSEARCH_URI} \
  --es.all \
  --es.indices \
  --es.timeout=30s \
  --es.ssl-skip-verify \
  --es.user=${OPENSEARCH_USER} \
  --es.pass=${OPENSEARCH_PASSWORD}

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

