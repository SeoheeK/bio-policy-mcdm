## MinIO systemd EnvironmentFile 예시
## 실제 운영에서는 /etc/minio/minio.env로 배치하세요.

# 관리자 계정(실제 값은 secrets로 주입 권장)
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=CHANGE_ME

# 콘솔 포트(기본 9001)
MINIO_OPTS=--console-address :9001

# 분산 볼륨(명시적으로 펼친 형태 — systemd brace-expansion 미사용)
MINIO_VOLUMES=http://10.10.31.10/data/minio/disk1 http://10.10.31.10/data/minio/disk2 http://10.10.31.10/data/minio/disk3 http://10.10.31.10/data/minio/disk4 http://10.10.31.10/data/minio/disk5 http://10.10.31.10/data/minio/disk6 http://10.10.31.10/data/minio/disk7 http://10.10.31.10/data/minio/disk8 http://10.10.31.11/data/minio/disk1 http://10.10.31.11/data/minio/disk2 http://10.10.31.11/data/minio/disk3 http://10.10.31.11/data/minio/disk4 http://10.10.31.11/data/minio/disk5 http://10.10.31.11/data/minio/disk6 http://10.10.31.11/data/minio/disk7 http://10.10.31.11/data/minio/disk8 http://10.10.31.12/data/minio/disk1 http://10.10.31.12/data/minio/disk2 http://10.10.31.12/data/minio/disk3 http://10.10.31.12/data/minio/disk4 http://10.10.31.12/data/minio/disk5 http://10.10.31.12/data/minio/disk6 http://10.10.31.12/data/minio/disk7 http://10.10.31.12/data/minio/disk8 http://10.10.31.13/data/minio/disk1 http://10.10.31.13/data/minio/disk2 http://10.10.31.13/data/minio/disk3 http://10.10.31.13/data/minio/disk4 http://10.10.31.13/data/minio/disk5 http://10.10.31.13/data/minio/disk6 http://10.10.31.13/data/minio/disk7 http://10.10.31.13/data/minio/disk8

