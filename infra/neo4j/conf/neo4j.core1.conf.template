############################################
# Neo4j 5.15 Enterprise - Core 1
############################################

# 기본
dbms.default_listen_address=0.0.0.0
dbms.default_advertised_address=10.10.21.30

# 커넥터
server.bolt.enabled=true
server.bolt.listen_address=:7687
server.http.enabled=true
server.http.listen_address=:7474

# 인증
dbms.security.auth_enabled=true

# 메모리(64GB RAM 예시)
server.memory.heap.initial_size=8g
server.memory.heap.max_size=8g
server.memory.pagecache.size=20g

# ===== 클러스터(Enterprise) =====
dbms.cluster.discovery.type=LIST
dbms.cluster.discovery.endpoints=10.10.21.30:5000,10.10.21.31:5000,10.10.21.32:5000
dbms.cluster.advertised_address=10.10.21.30:6000
dbms.cluster.discovery.advertised_address=10.10.21.30:5000

dbms.mode=CORE
causal_clustering.minimum_core_cluster_size_at_formation=3
causal_clustering.minimum_core_cluster_size_at_runtime=3

# 트랜잭션/체크포인트(예시)
dbms.transaction.timeout=30s
dbms.checkpoint.interval.time=15m

# 백업 포트(Enterprise online backup)
server.backup.enabled=true
server.backup.listen_address=0.0.0.0:6362

# Prometheus metrics (Neo4j 5)
# - Prometheus가 scrape할 수 있도록 별도 엔드포인트를 엽니다.
server.metrics.prometheus.enabled=true
server.metrics.prometheus.endpoint=0.0.0.0:2004

